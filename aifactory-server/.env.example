# Environment: development (default). Keep real production and test values in
# your deployment secret store or local untracked env files.
# NODE_ENV=development

DATABASE_URL="mysql://aifactory:aifactory_dev@localhost:33306/agentcraft_public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3100
CORS_ORIGIN="http://localhost:5174,http://localhost:8088"

# OAuth - GitHub (Get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3100/api/auth/github/callback"

# OAuth - Google (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3100/api/auth/google/callback"

# OAuth - X.com (Get from https://developer.x.com/)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_CALLBACK_URL="http://localhost:3100/api/auth/x/callback"

# OAuth redirect URL after login (frontend URL)
OAUTH_REDIRECT_URL="http://localhost:5174/oauth/callback"

# Email verification (Resend API preferred; SMTP fallback)
APP_NAME="Agent Craft"
RESEND_API_KEY=""
RESEND_FROM="Agent Craft <onboarding@resend.dev>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_DEBUG_RESPONSE=false
# Local/test only: allow registration without sending or requiring an email code.
EMAIL_VERIFICATION_DISABLED=false

# Redis (optional — rate-limiting disabled if not set)
REDIS_URL=""

# API rate limiting (requires Redis)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# MCP server (independent process)
MCP_PORT=3101
MCP_HOST="127.0.0.1"
AIFACTORY_API_BASE_URL="http://localhost:3100/api"
# Optional bootstrap bearer token used by MCP tools that require auth
MCP_AUTH_TOKEN=""
# MCP API keys for public access (comma-separated; empty = open access for local dev)
MCP_API_KEYS=""
# MCP rate limiting (requires Redis)
MCP_RATE_LIMIT_MAX=30
MCP_RATE_LIMIT_WINDOW_SEC=60

# Agent workspace host integration
AGENT_WORKSPACE_BASE_URL="http://localhost:3110"
AGENT_WORKSPACE_HOST_KEY="dev-agent-workspace-host-key"
# Optional public/proxied workspace URL injected into local-runner containers.
HERMES_AGENT_LOCAL_RUNNER_WORKSPACE_BASE_URL=""

# Project shared storage (S3-compatible object storage). PROJECT_STORAGE_* wins
# over TOS_* when both are present.
PROJECT_STORAGE_ENDPOINT=""
PROJECT_STORAGE_REGION=""
PROJECT_STORAGE_BUCKET=""
PROJECT_STORAGE_FOLDER=""
PROJECT_STORAGE_ACCESS_KEY=""
PROJECT_STORAGE_SECRET_KEY=""
PROJECT_STORAGE_PUBLIC_URL=""

# Legacy TOS aliases, accepted for compatibility.
TOS_ENDPOINT=""
TOS_REGION=""
TOS_BUCKET=""
TOS_FOLDER="avatars"
TOS_ACCESS_KEY=""
TOS_SECRET_KEY=""
TOS_PUBLIC_URL=""

# Economy
DAILY_INJECT_AMOUNT=10000
AI_TASK_RATIO=0.7
AI_TASK_MIN_REWARD=5
AI_TASK_MAX_REWARD=100
SIGNUP_BONUS=5
SYSTEM_USER_EMAIL=system@aifactory.local
SYSTEM_USER_PASSWORD=change-me-local
# Optional old system account alias for private migrations. Leave blank for new installs.
LEGACY_SYSTEM_EMAIL=""

# LLM for AI task generation (server-side, optional)
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_API_TYPE="openai"

# HackerOne task generator fetch credentials (server-side, optional)
HACKERONE_USERNAME=""
HACKERONE_API_TOKEN=""
HACKERONE_FETCH_LIMIT=25
HACKERONE_SCOPE_FETCH_LIMIT=100

# Blockchain / AIC Token (on-chain integration)
# 32-byte hex key for AES-256-GCM encryption of custodial wallet private keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=""
# Optional dedicated 32-byte hex key for project global secrets.
# If unset, the server falls back to PROJECT_SECRET_ENCRYPTION_KEY and then WALLET_ENCRYPTION_KEY.
PROJECT_GLOBAL_SECRET_KEY=""
# AIC ERC-20 contract address
AIC_CONTRACT_ADDRESS=""
# Polygon RPC URL
POLYGON_RPC_URL="https://polygon-rpc.com"
# Reward pool wallet private key (for on-chain withdrawals)
REWARD_POOL_PRIVATE_KEY=""
# Deployer wallet private key (for signup bonus airdrop of 5 AIC)
DEPLOYER_PRIVATE_KEY=""
